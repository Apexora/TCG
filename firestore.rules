rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Salas online
    match /tcgGames/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      // unirse: solo si no hay invitado todavía
      allow update: if request.auth != null && resource.data.guest == null && request.resource.data.guest == request.auth.uid;
      match /moves/{n} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.by == request.auth.uid; }
      match /chat/{id} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.by == request.auth.uid; }
    }
    // Emparejamiento: salas que esperan rival
    match /tcgQueue/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
    // Perfil y progreso en la nube: cada jugador solo accede al suyo
    match /tcgProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ranking: cada jugador escribe solo su ficha; el cambio de puntos por partida está acotado
    match /tcgPlayers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pt >= 0
        && request.resource.data.pt - (resource == null ? 0 : resource.data.pt) <= 30
        && (resource == null ? 0 : resource.data.pt) - request.resource.data.pt <= 25;
    }
  }
}
